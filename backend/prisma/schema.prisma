generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  name                 String
  cpf                  String         @unique
  password             String?
  roleId               String
  role                 Role           @relation(fields: [roleId], references: [id])
  status               String         @default("ACTIVE")
  theme                String         @default("DARK")
  notificationsEnabled Boolean        @default(true)
  orders               Order[]
  auditLogs            AuditLog[]
  scannerEvents        ScannerEvent[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique
  email     String
  orders    Order[]
  createdAt DateTime @default(now())
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique
  email     String
  lots      Lot[]
  createdAt DateTime @default(now())
}

model Product {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  category    String
  price       Float
  minStock    Int           @default(10)
  lots        Lot[]
  units       ProductUnit[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Lot {
  id                String        @id @default(uuid())
  code              String        @unique
  productId         String
  supplierId        String
  quantity          Int
  availableQuantity Int
  expirationDate    DateTime
  status            String        @default("ACTIVE")
  location          String
  product           Product       @relation(fields: [productId], references: [id])
  supplier          Supplier      @relation(fields: [supplierId], references: [id])
  units             ProductUnit[]
  orderItems        OrderItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model ProductUnit {
  id              String         @id @default(uuid())
  uniqueCode      String         @unique
  qrCodeValue     String         @unique
  productId       String
  lotId           String
  status          String         @default("AVAILABLE")
  currentLocation String?
  product         Product        @relation(fields: [productId], references: [id])
  lot             Lot            @relation(fields: [lotId], references: [id])
  events          ScannerEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Order {
  id          String      @id @default(uuid())
  code        String      @unique
  customerId  String
  sellerId    String
  status      String      @default("PENDING")
  totalAmount Float
  justification String?
  customer    Customer    @relation(fields: [customerId], references: [id])
  seller      User        @relation(fields: [sellerId], references: [id])
  items       OrderItem[]
  shipments   Shipment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  lotId       String?
  quantity    Int
  unitPrice   Float
  fifoApplied Boolean  @default(false)
  order       Order    @relation(fields: [orderId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  lot         Lot?     @relation(fields: [lotId], references: [id])
}

model Shipment {
  id            String   @id @default(uuid())
  orderId       String
  status        String   @default("PREPARING")
  trackingCode  String?  @unique
  dispatchedAt  DateTime?
  order         Order    @relation(fields: [orderId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ScannerEvent {
  id            String       @id @default(uuid())
  unitId        String
  userId        String
  eventType     String
  location      String?
  unit          ProductUnit  @relation(fields: [unitId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())
}

model Inventory {
  id          String   @id @default(uuid())
  location    String   @unique
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryMovement {
  id          String   @id @default(uuid())
  productId   String
  quantity    Int
  type        String
  reason      String
  createdAt   DateTime @default(now())
}

model Discrepancy {
  id          String   @id @default(uuid())
  productId   String
  expectedQty Int
  actualQty   Int
  status      String   @default("OPEN")
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  entity      String
  description String
  ipAddress   String?
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String
  isRead      Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
}
