{
  "name": "beesystem-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "iniciar": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "construir": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "gerar-db": "npm run gerar-db --workspace=backend && npm run gerar-db --workspace=frontend",
    "db:push": "npm run db:push --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "criar-usuario": "npm run criar-usuario --workspace=backend"
  }
}
